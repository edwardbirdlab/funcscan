/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/funcscan 4.0.0 — Ceres run profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Usage:
      nextflow run -resume /path/to/funcscan \
          -c funcscan_ceres.config \
          --input samplesheet.csv \
          --outdir results \
          ...
*/

params {
    config_profile_description = 'USDA ARS SCINet Ceres Cluster profile (funcscan 4.0.0)'
}

singularity {
    enabled    = true
    autoMounts = true
}

report {
    overwrite = true
}
timeline {
    overwrite = true
}

process {
    executor       = 'slurm'
    queue          = 'ceres'
    clusterOptions = " -A ${System.getenv('SLURM_JOB_ACCOUNT')} "

    resourceLimits = [
        cpus  : 36,
        memory: 640.GB,
        time  : 21.d,
    ]

    scratch = true

    errorStrategy = {
        if (task.exitStatus in ((130..145) + [104] + (175..177))) {
            sleep(200)
            return 'retry'
        }
        return 'finish'



    }
    maxRetries = 4

    withName: AMPCOMBI2_PARSETABLES {
    publishDir = [
        path: { "${params.outdir}/reports/ampcombi2/" },
        mode: 'copy',
        saveAs: { filename -> (filename == 'versions.yml' || filename == 'Ampcombi_parse_tables.log' || filename.startsWith('amp_')) ? null : filename },]
    }


}
