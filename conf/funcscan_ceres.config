/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/funcscan 4.0.0 — Ceres run profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Companion to base.config for screening bacterial bins/plasmids on Ceres.

    Usage:
      nextflow run -resume /path/to/funcscan \
          -c funcscan_ceres.config \
          --input samplesheet.csv \
          --outdir results \
          ...
*/

def RETRYABLE_EXIT_CODES = (130..145) + [104] + (175..177)

params {
    config_profile_description = 'USDA ARS SCINet Ceres Cluster profile (funcscan 4.0.0)'
    config_profile_contact     = 'SCINet VRSC (scinet_vrsc@usda.gov)'
    config_profile_url         = 'https://scinet.usda.gov/guides/resources/ceres'
}

singularity {
    enabled    = true
    autoMounts = true
}

report {
    overwrite = true
}
timeline {
    overwrite = true
}

process {
    executor       = 'slurm'
    queue          = 'ceres'
    clusterOptions = " -A ${System.getenv('SLURM_JOB_ACCOUNT')} "

    // Ceres node/partition ceiling -- same values proven out on the mag Ceres config.
    resourceLimits = [
        cpus  : 36,
        memory: 640.GB,
        time  : 21.d,
    ]

    scratch = true

    errorStrategy = {
        if (task.exitStatus in RETRYABLE_EXIT_CODES) {
            sleep(200)
            return 'retry'
        }
        return 'finish'
    }
    maxRetries = 4

    // No per-process resource overrides yet -- base.config's own withLabel/withName
    // defaults haven't been tested against real bin/plasmid data on Ceres. Add
    // withName overrides here once a real run proves one of them insufficient,
    // the same way mag's CONCOCT/MEGAHIT/metaSPAdes overrides were built up.
}
